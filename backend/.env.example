SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change-me

# Get this from your Neon (neon.tech) project dashboard — same URL works
# locally and once deployed, no migration needed later.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Fallback with zero setup, e.g. for quick local testing without Neon:
# DATABASE_URL=sqlite:///./fraud.db

MODEL_PATH=./model/FraudGNN_main.pt
TYPE_ENCODER_PATH=./model/type_encoder.pkl
SCALER_PATH=./model/scaler.pkl

# Get this from your Upstash (upstash.com) Redis database dashboard — free
# tier, no Docker, same "hosted" pattern as Neon above. /score degrades
# gracefully (fewer neighbours found, doesn't crash) if this is unreachable.
REDIS_URL=redis://default:password@example.upstash.io:6379
# Fallback for local testing if you have Redis running locally:
# REDIS_URL=redis://localhost:6379/0
