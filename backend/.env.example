SECRET_KEY=change-me-to-a-long-random-string

# One-time bootstrap admin — seeded only if the users table is empty. Every
# other account (including future analysts) is created afterwards via the
# admin API/UI (POST /auth/users), not env vars. Change this password
# immediately after first login (the account is created with
# must_change_password=True, so the app will force this).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Session cookies. Locally, frontend (localhost:3000) and backend
# (localhost:8000) are same-site (cookie scoping ignores port), so the
# defaults below (plain http, Lax) work with zero setup.
#
# A real deployment with frontend/backend on different domains is
# cross-site and MUST use:
#   COOKIE_SECURE=True
#   COOKIE_SAMESITE=none
# (the app refuses to start with SameSite=none + Secure=False, since
# browsers reject that combination outright). Note some browsers'
# third-party-cookie protections (Safari ITP, Chrome) may still block a
# cross-domain SameSite=None cookie by default — serving frontend and
# backend from the same parent domain avoids that entirely.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Comma-separated list of allowed frontend origins (CORS). Add your deployed
# frontend's URL here once you have one.
CORS_ORIGINS=http://localhost:3000

# Get this from your Neon (neon.tech) project dashboard — same URL works
# locally and once deployed, no migration needed later.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Fallback with zero setup, e.g. for quick local testing without Neon:
# DATABASE_URL=sqlite:///./fraud.db

MODEL_PATH=./model/FraudGNN_main.pt
TYPE_ENCODER_PATH=./model/type_encoder.pkl
SCALER_PATH=./model/scaler.pkl

# Get this from Upstash (upstash.com) — click the "TCP" tab (NOT "REST") on
# your database's Connect panel, reveal the password, and build the URL as
# shown below. This code uses the standard redis-py TCP client, not
# Upstash's REST API, so there's no separate token — the password is
# embedded directly in the URL. Must be "rediss://" (double s) for TLS,
# which Upstash requires; a plain "redis://" URL will fail to connect.
# /score degrades gracefully (fewer neighbours found, doesn't crash) if
# this is unreachable, so it's not blocking if you skip it for now. The
# same is true of login rate-limiting (rate_limit.py) — it fails open.
REDIS_URL=rediss://default:password@example.upstash.io:6379
# Fallback for local testing if you have Redis running locally (no TLS needed):
# REDIS_URL=redis://localhost:6379/0
